# Copy to .env and fill real values. Never commit .env.

# QuickML published endpoint OR this app's public /api/predict proxy
QUICKML_ENDPOINT_URL=YOUR_PUBLISHED_QUICKML_ENDPOINT_URL_HERE
QUICKML_AUTH_MODE=none
QUICKML_PAYLOAD_MODE=data_list
QUICKML_CHUNK=100
QUICKML_WORKERS=4
QUICKML_STRICT=0
QUICKML_MODEL_VERSION=v1
QUICKML_ENV=Development

# Required only when QUICKML_AUTH_MODE=oauth
QUICKML_ENDPOINT_KEY=
CATALYST_ORG=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

CORS_ALLOW_ORIGIN=*
MAX_ROWS=1000
DAILY_QUICKML_BUDGET=300
PORT=8080
LOG_LEVEL=INFO
